# Copy to .env (never commit .env). Loaded by application.yml for local runs.

# Shared rentamovil database, as the iam_app user (rtm-iam-db, 03_dcl), never sa.
# DATABASE_PASSWORD = parameter.iamAppPassword from rtm-iam-db/liquibase.properties
DATABASE_URL=jdbc:sqlserver://localhost:1433;databaseName=rentamovil;encrypt=true;trustServerCertificate=true
DATABASE_USERNAME=iam_app
DATABASE_PASSWORD=ChangeMe_IamApp123!

APP_IAM_PORT=3001

# Used from the JWT step onwards (07-api/authentication.md)
APP_IAM_JWT_PRIVATE_KEY=
APP_IAM_JWT_PUBLIC_KEY=
APP_IAM_JWT_EXPIRY=1800
APP_IAM_REFRESH_TOKEN_EXPIRY=604800
APP_IAM_BCRYPT_ROUNDS=12
