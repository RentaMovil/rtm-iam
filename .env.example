# Copia este archivo a .env (el .env nunca se sube). Lo carga application.properties.

# Base compartida rentamovil con el usuario iam_app (rtm-iam-db, 03_dcl), nunca sa.
# DATABASE_PASSWORD = el parameter.iamAppPassword de rtm-iam-db/liquibase.properties
DATABASE_URL=jdbc:sqlserver://localhost:1433;databaseName=rentamovil;encrypt=true;trustServerCertificate=true
DATABASE_USERNAME=iam_app
DATABASE_PASSWORD=<password-del-usuario-iam_app>

APP_IAM_PORT=3001

# Par de claves RS256 (ver README, "Claves JWT"): el texto base64 del PEM en una sola línea.
# Cada entorno tiene su propio par; nunca se reutiliza ni se sube.
APP_IAM_JWT_PRIVATE_KEY=
APP_IAM_JWT_PUBLIC_KEY=
APP_IAM_JWT_EXPIRY=1800
APP_IAM_REFRESH_TOKEN_EXPIRY=604800
APP_IAM_BCRYPT_ROUNDS=12


# SMTP Configuration (para envío de emails)
# SMTP Configuration - SendGrid
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=<sendgrid-api-key>
SMTP_FROM_EMAIL=rentamovil0@gmail.com
SMTP_FROM_NAME=RentaMovil
